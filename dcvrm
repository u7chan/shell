#!/bin/bash
#
# Remove all unused Docker volumes.
#

set -ea

# Logging functions
log_info()  { echo "[INFO] $*"; }
log_step()  { echo "[STEP] $*"; }
log_ok()    { echo "[OK]   $*"; }
log_error() { echo "[ERROR] $*" >&2; }

CONTAINER_RUNTIME=${CONTAINER_RUNTIME:-docker}

log_step "Removing unused volumes..."

$CONTAINER_RUNTIME volume prune -a -f

log_ok "All unused volumes removed"
