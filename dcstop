#!/bin/bash
#
# Stop all running Docker containers.
#

set -ea

# Logging functions
log_info()  { echo "[INFO] $*"; }
log_step()  { echo "[STEP] $*"; }
log_ok()    { echo "[OK]   $*"; }
log_skip()  { echo "[SKIP] $*"; }
log_warn()  { echo "[WARN] $*" >&2; }
log_error() { echo "[ERROR] $*" >&2; }

CONTAINER_RUNTIME=${CONTAINER_RUNTIME:-docker}

log_step "Fetching running containers..."

CONTAINERS=$($CONTAINER_RUNTIME ps -q)

if [ -z "$CONTAINERS" ]; then
  log_skip "No running containers found"
  exit 0
fi

COUNT=$(echo "$CONTAINERS" | wc -l | tr -d ' ')
log_info "Found $COUNT running container(s)"

log_step "Stopping all containers..."
# shellcheck disable=SC2086
$CONTAINER_RUNTIME stop $CONTAINERS

log_ok "All containers stopped"
