#!/bin/bash
#
# Inject SSH private key into a DevContainer for git operations.
# Requires: docker, ~/.ssh/id_ed25519 on host
#
# Usage: sendkey <CONTAINER_ID> [CONTAINER_USER]
#

set -ea

# Logging functions
log_info() { echo "[INFO] $*"; }
log_step() { echo "[STEP] $*"; }
log_ok()   { echo "[OK]   $*"; }
log_skip() { echo "[SKIP] $*"; }
log_warn() { echo "[WARN] $*"; }
log_error() { echo "[ERROR] $*" >&2; }

function show_usage {
  echo "Usage: $0 [<Argments>]"
  echo ""
  echo "Argments: "
  echo "  [1]: CONTAINER_ID"
  echo "  [2]: CONTAINER_USER (root:default)"
  echo ""
}

SSH_PRIVATEKEY_PATH=~/.ssh/id_ed25519

CONTAINER_ID=$1
CONTAINER_USER="root"
CONTAINER_HOME="/$CONTAINER_USER"

if [ -z "$1" ]; then
  show_usage
  exit 1
fi

if [ -n "$2" ]; then
  CONTAINER_USER=$2
  CONTAINER_HOME=/home/$CONTAINER_USER
fi

CONTAINER_SSH_KEY_PATH=$CONTAINER_HOME/.ssh/id_rsa

set +e

FIND_CONTAINER=$(docker ps | grep "^$CONTAINER_ID" | awk '{print $1}')
FIND_IMAGE=$(docker ps | grep "^$CONTAINER_ID" | awk '{print $2}')

set -e

ERROR=0

if [ -z "$FIND_CONTAINER" ]; then
  FIND_CONTAINER="N/A"
  FIND_IMAGE="N/A"
  ERROR=1
fi

log_info "Target container: $FIND_CONTAINER ($FIND_IMAGE)"
log_info "User: $CONTAINER_USER"

if [ "$ERROR" -eq 1 ]; then
  log_error "Container '$CONTAINER_ID' not found or not running"
  exit 1
fi

# Check if user exists in container
log_step "Checking if user '$CONTAINER_USER' exists in container..."
if ! docker exec "$CONTAINER_ID" id -u "$CONTAINER_USER" >/dev/null 2>&1; then
  log_error "User '$CONTAINER_USER' does not exist in container '$CONTAINER_ID'"
  log_info "Available users in container:"
  docker exec "$CONTAINER_ID" cat /etc/passwd 2>/dev/null | cut -d: -f1 | sort | tr '\n' ' ' || echo "(unable to list users)"
  echo ""
  log_info "Please specify a valid user with: $0 <CONTAINER_ID> <CONTAINER_USER>"
  exit 1
fi
log_ok "User '$CONTAINER_USER' exists"

# =============================================================================
# Inject SSH key
# =============================================================================

log_step "Injecting SSH key..."
docker cp $SSH_PRIVATEKEY_PATH $CONTAINER_ID:$CONTAINER_SSH_KEY_PATH
docker exec -u root $CONTAINER_ID chmod 600 $CONTAINER_SSH_KEY_PATH
docker exec -u root $CONTAINER_ID chown $CONTAINER_USER:$CONTAINER_USER $CONTAINER_SSH_KEY_PATH
log_ok "SSH key injected to $CONTAINER_SSH_KEY_PATH"