#!/bin/bash
#
# Install Claude CLI into a DevContainer and inject host credentials.
# Requires: docker (or $CONTAINER_RUNTIME), ca-certificates in container image
#
# Usage: devc-claude <CONTAINER_ID> [CONTAINER_USER] [JSON_PATH]
#

set -ea

function show_usage {
  echo "Usage: $0 [<Argments>]"
  echo ""
  echo "Argments: "
  echo "  [1]: CONTAINER_ID"
  echo "  [2]: CONTAINER_USER (vscode:default)"
  echo "  [3]: JSON_PATH (~/.claude.json:default)"
  echo ""
}

CLAUDE_CONFIG_PATH="$HOME/.claude.json"

CONTAINER_ID=$1
CONTAINER_USER="vscode"
CONTAINER_HOME="/home/$CONTAINER_USER"
CONTAINER_RUNTIME=${CONTAINER_RUNTIME:-docker}

if [ -z "$1" ]; then
  show_usage
  exit 1
fi

if [ -n "$2" ]; then
  CONTAINER_USER=$2
  if [ "$CONTAINER_USER" = "root" ]; then
    CONTAINER_HOME="/root"
  else
    CONTAINER_HOME="/home/$CONTAINER_USER"
  fi
fi

if [ -n "$3" ]; then
  CLAUDE_CONFIG_PATH=$3
fi

CONTAINER_CLAUDE_CONFIG_FILE=$CONTAINER_HOME/.claude.json

set +e

FIND_CONTAINER=$($CONTAINER_RUNTIME ps | grep "^$CONTAINER_ID" | awk '{print $1}')
FIND_IMAGE=$($CONTAINER_RUNTIME ps | grep "^$CONTAINER_ID" | awk '{print $2}')

set -e

ERROR=0

if [ -z "$FIND_CONTAINER" ]; then
  FIND_CONTAINER="N/A"
  FIND_IMAGE="N/A"
  ERROR=1
fi

echo "CONTAINER_ID    : $FIND_CONTAINER"
echo "CONTAINER_IMAGE : $FIND_IMAGE"
echo "CONTAINER_USER  : $CONTAINER_USER"
echo "CONTAINER_RUNTIME: $CONTAINER_RUNTIME"

if [ "$ERROR" -eq 1 ]; then
  exit 1
fi

if [ ! -f "$CLAUDE_CONFIG_PATH" ]; then
  echo "Error: Claude config file not found at $CLAUDE_CONFIG_PATH"
  exit 1
fi

# Check if Claude CLI is already installed
CLAUDE_INSTALLED=$($CONTAINER_RUNTIME exec -u "$CONTAINER_USER" "$CONTAINER_ID" bash -c 'test -f ~/.local/bin/claude && echo "yes" || echo "no"' 2>/dev/null)

# Install Claude CLI in container (as CONTAINER_USER)
# PREREQUISITE: コンテナイメージに ca-certificates パッケージが必要です
if [ "$CLAUDE_INSTALLED" = "yes" ]; then
  echo "Claude CLI already installed, skipping..."
else
  echo "Installing Claude CLI..."
  $CONTAINER_RUNTIME exec -u "$CONTAINER_USER" "$CONTAINER_ID" bash -c 'curl -fsSL https://claude.ai/install.sh | bash'
fi

# Check if PATH is already configured
PATH_CONFIGURED=$($CONTAINER_RUNTIME exec -u "$CONTAINER_USER" "$CONTAINER_ID" bash -c 'grep -q ".local/bin" ~/.bashrc 2>/dev/null && echo "yes" || echo "no"')

if [ "$PATH_CONFIGURED" = "yes" ]; then
  echo "PATH already configured, skipping..."
else
  echo "Configuring PATH..."
  $CONTAINER_RUNTIME exec -u "$CONTAINER_USER" "$CONTAINER_ID" bash -c 'echo '"'"'export PATH="$HOME/.local/bin:$PATH"'"'"' >> ~/.bashrc'
fi

# Inject credential (check if file exists and has same content)
NEED_COPY=true
if $CONTAINER_RUNTIME exec -u "$CONTAINER_USER" "$CONTAINER_ID" test -f "$CONTAINER_CLAUDE_CONFIG_FILE" 2>/dev/null; then
  # Compare content using md5sum
  HOST_MD5=$(md5sum "$CLAUDE_CONFIG_PATH" | awk '{print $1}')
  CONTAINER_MD5=$($CONTAINER_RUNTIME exec -u "$CONTAINER_USER" "$CONTAINER_ID" bash -c "md5sum $CONTAINER_CLAUDE_CONFIG_FILE 2>/dev/null | awk '{print \$1}'")
  if [ "$HOST_MD5" = "$CONTAINER_MD5" ]; then
    echo "Credential already up to date, skipping..."
    NEED_COPY=false
  fi
fi

if [ "$NEED_COPY" = true ]; then
  echo "Injecting credential..."
  $CONTAINER_RUNTIME cp "$CLAUDE_CONFIG_PATH" "$CONTAINER_ID:$CONTAINER_CLAUDE_CONFIG_FILE"
  $CONTAINER_RUNTIME exec -u root "$CONTAINER_ID" chown "$CONTAINER_USER:$CONTAINER_USER" "$CONTAINER_CLAUDE_CONFIG_FILE"
fi

# Copy skills directory (handle symlink)
HOST_SKILLS_DIR="$HOME/.claude/skills"
CONTAINER_CLAUDE_DIR="$CONTAINER_HOME/.claude"
CONTAINER_SKILLS_DIR="$CONTAINER_CLAUDE_DIR/skills"

# Resolve symlink if needed
if [ -L "$HOST_SKILLS_DIR" ]; then
  REAL_SKILLS_DIR=$(readlink -f "$HOST_SKILLS_DIR")
else
  REAL_SKILLS_DIR="$HOST_SKILLS_DIR"
fi

if [ -d "$REAL_SKILLS_DIR" ]; then
  # Check if skills directory already exists in container
  SKILLS_EXIST=$($CONTAINER_RUNTIME exec -u "$CONTAINER_USER" "$CONTAINER_ID" bash -c "test -d $CONTAINER_SKILLS_DIR && echo 'yes' || echo 'no'" 2>/dev/null)

  if [ "$SKILLS_EXIST" = "yes" ]; then
    echo "Skills directory already exists, skipping..."
  else
    if [ -L "$HOST_SKILLS_DIR" ]; then
      echo "Skills is symlink, copying from $REAL_SKILLS_DIR..."
    else
      echo "Copying skills directory..."
    fi
    $CONTAINER_RUNTIME exec -u "$CONTAINER_USER" "$CONTAINER_ID" mkdir -p "$CONTAINER_CLAUDE_DIR"
    $CONTAINER_RUNTIME cp "$REAL_SKILLS_DIR" "$CONTAINER_ID:$CONTAINER_SKILLS_DIR"
  fi
fi

echo "Done."
